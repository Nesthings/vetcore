# Environment
# API
APP_NAME=VetCore API
ENV=development
DEBUG=true
BACKEND_PORT=8001

# Database (PostgreSQL via docker-compose)
POSTGRES_USER=vetcore
POSTGRES_PASSWORD=vetcore_dev
POSTGRES_DB=vetcore
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://vetcore:vetcore_dev@localhost:5433/vetcore

# Auth (JWT propio)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Super-admin (dueño del producto)
SUPER_ADMIN_EMAIL=admin@vetcore.app
SUPER_ADMIN_PASSWORD=change-me-in-production
SUPER_ADMIN_NAME=Super Admin

# Storage de media (MVP local → Cloudflare R2 cuando haya credenciales)
MEDIA_ROOT=media
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
