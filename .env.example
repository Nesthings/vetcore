# Environment
# API
APP_NAME=VetCore API
ENV=development
DEBUG=true
BACKEND_PORT=8001

# Database (PostgreSQL via docker-compose)
POSTGRES_USER=vetcore
POSTGRES_PASSWORD=vetcore_dev
POSTGRES_DB=vetcore
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://vetcore:vetcore_dev@localhost:5433/vetcore

# Auth (JWT propio)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage de media (Cloudflare R2 — se usa desde Fase 1.4+)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
